<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<divergeek_converter xmlns="https://www.mlogica.com">
	<properties>
		<property name="create_date" value="2026-08-15 07:44:12.654"/>
		<property name="project_name" value="AWS_CARDS_DEMO"/>
		<property name="rights" value="mLogica"/>
		<!--
			One of the following values:
			jcl
			proc
			cobol
			bms
		-->
		<property name="converter" value="jcl"/>
		<property name="workspace" value="ENV{DG_CONV_WORKSPACE_IN}"/>
		<property name="delivery_project_root" value="ENV{DG_CONV_WORKSPACE_OUT}\nib-dot-net\Samples\AwsCardsDemo"/>
		<property name="profile" value="jcl_pwsh_profile"/>
		<property name="skeleton" value="skeleton_jcl_pwsh.txt"/>
	</properties>
	<resources>
		<resource pattern="*" location="sources\jcl" output="${delivery_project_root}\Scripts" />
	</resources>
	<converter_settings>
		<setting name="target_syntax" value="PWSH" />
		<setting name="target_os" value="windows" />
		<setting name="target_db" value="MSSQLSRV" />
		<setting name="output_embedded_cards" value="${delivery_project_root}\Data" />
		<setting name="procs_location" value="${workspace}\sources\proc" />
		<setting name="procs_package" value="Procs" />
		<setting name="includes_location" value="${workspace}\sources\proc" />
		<setting name="ccards_location" value="${workspace}\sources\ctl" />
		<setting name="ignore_severe_errors" value="false" />
	</converter_settings>
</divergeek_converter>
